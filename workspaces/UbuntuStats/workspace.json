{
  "description": "A Debian KASM image with Statistics Software.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu.png",
  "name": "4lge/kasm-debian-stat:master",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "OS"
  ],
  "friendly_name": "Debian Statistics",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    "1.17.x"
  ],
  "uncompressed_size_mb": 1012
}
